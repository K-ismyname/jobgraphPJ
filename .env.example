# ============================================================
# LLM — 필수 (없으면 키워드 룰 기반 mock 추출로 동작)
# ============================================================
OPENAI_API_KEY=             # platform.openai.com 발급

# ============================================================
# 데이터 소스 — 없으면 jobs.json 캐시 사용, 그것도 없으면 mock 2개 반환
# ============================================================
ADZUNA_APP_ID=              # developer.adzuna.com 발급 (무료)
ADZUNA_APP_KEY=

# ============================================================
# 그래프 DB — 필수 (없으면 EnvironmentError로 기동 실패)
# ============================================================
# ⚠️ 로컬 개발에는 로컬 Neo4j를 쓰세요. 개발 중 실수 한 번이 곧 프로덕션 데이터 오염입니다.
#    (실제로 2026-06-30 백필 실험이 라이브 직군 분석을 오염시켜 롤백한 전례가 있습니다.)
#
#    로컬 실행:  docker-compose up -d neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

#    배포(HF Spaces)에서는 Aura URI를 **시크릿으로만** 주입하세요. 이 파일이나 로컬 .env에
#    Aura URI를 두면, 로컬에서 돌린 스크립트가 그대로 라이브를 건드립니다.
#    NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
#
# 원격(neo4j+s://) 연결에서는 clear_all() 같은 파괴적 작업이 차단됩니다.
# 정말 의도한 경우에만 아래를 설정하세요 (평소에는 비워두세요).
# ALLOW_REMOTE_DESTRUCTIVE=true

# ============================================================
# 공개 배포 — 데모 비용/접근 보호
# ============================================================
# ACCESS_KEY: 설정하면 이 키를 가진 요청만 일일 상한을 면제받습니다.
#   공개 배포(SPACE_ID 존재)에서 이 값이 비어 있으면 관리자는 아무도 없고, 모든 방문자가
#   일일 상한을 적용받습니다 (fail-closed — 키를 깜빡해도 과금이 열리지 않습니다).
ACCESS_KEY=
DEMO_DAILY_LIMIT=3          # IP별 하루 분석 횟수 (0이면 무제한)

# ============================================================
# 평가 — 선택 (없으면 트레이싱·지표만 비활성화, 나머지 정상 동작)
# ============================================================
RAGAS_RUNS=3                # RAGAS는 실행마다 점수가 흔들려 반복 측정이 필수 (단일 실행 결론 금지)
LANGFUSE_PUBLIC_KEY=        # cloud.langfuse.com 발급
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================
# GitHub — 선택 (없으면 confidence 레벨 상승 기능만 비활성화)
# ============================================================
GITHUB_TOKEN=               # repo read 권한 Personal Access Token

# ============================================================
# 파인튜닝 모델 — 예정/미구현 (6단계). 현재 코드는 USE_LOCAL_MODEL을 읽지 않고 항상 OpenAI 사용
# ============================================================
# HF Hub ID:     USE_LOCAL_MODEL=your_username/qwen2.5-1.5b-job-skill-extractor
# 로컬 경로:     USE_LOCAL_MODEL=./finetune/checkpoints/best_adapter
# 미설정 시:     OpenAI gpt-4o-mini 사용 (기본 동작)
USE_LOCAL_MODEL=

# HF Hub 업로드용 (03_evaluate.ipynb에서 사용)
HF_TOKEN=
HF_REPO_ID=                 # e.g. your_username/qwen2.5-1.5b-job-skill-extractor
